{
  "name": "ai-provider-router",
  "private": true,
  "version": "1.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage && node scripts/coverage-summary.mjs",
    "key-leak-grep": "bash scripts/key-leak-grep.sh",
    "check-ts-version": "bash scripts/check-ts-version.sh",
    "check-version-sync": "bash scripts/check-version-sync.sh",
    "check-doc-links": "node scripts/check-doc-links.mjs",
    "docs:book": "node scripts/build-dev-book.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "dev": "pnpm --filter ai-provider-router-desktop tauri dev",
    "build": "pnpm -r build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
